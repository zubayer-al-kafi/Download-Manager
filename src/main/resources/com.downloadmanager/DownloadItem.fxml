<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="downloadItem"
      xmlns:fx="http://javafx.com/fxml/1"
      xmlns="http://javafx.com/javafx/26"
      fx:controller="com.downloadmanager.controller.DownloadItemController"
      spacing="12"
      styleClass="card"
      stylesheets="@style.css">

    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label fx:id="fileNameLabel" text="example.zip" HBox.hgrow="ALWAYS" styleClass="item-title"/>
        <Label fx:id="percentageLabel" text="0%" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #3b82f6;"/>
    </HBox>

    <Label fx:id="urlLabel" text="https://example.com/example.zip" maxWidth="Infinity" styleClass="text-muted"/>

    <ProgressBar fx:id="progressBar" progress="0" maxWidth="Infinity" styleClass="progress-bar"/>

    <HBox spacing="20" alignment="CENTER_LEFT">
        <Label fx:id="speedLabel" text="Speed: 0 KB/s" styleClass="text-muted"/>
        <Label fx:id="timeLabel" text="Time remaining: --" styleClass="text-muted"/>
    </HBox>

    <HBox spacing="10" alignment="CENTER_RIGHT" style="-fx-padding: 4 0 0 0;">
        <Button fx:id="showFolderButton" text="📁" onAction="#showInFolder" disable="true" styleClass="btn-secondary, btn-icon"/>
        <Button fx:id="deleteButton" text="Delete" onAction="#showDeleteMenu" disable="true" styleClass="btn-secondary"/>
        <Button fx:id="downloadAgainButton" text="Download Again" onAction="#downloadAgain" disable="true" styleClass="btn-secondary" style="-fx-text-fill: #3b82f6;"/>
        <Button fx:id="pauseButton" text="Pause" onAction="#pauseDownload" styleClass="btn-secondary"/>
        <Button fx:id="cancelButton" text="Cancel" onAction="#cancelDownload" styleClass="btn-danger-outline"/>
    </HBox>
</VBox>