<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="downloadItem"
      xmlns:fx="http://javafx.com/fxml/1"
      xmlns="http://javafx.com/javafx/26"
      fx:controller="com.downloadmanager.controller.DownloadItemController"
      spacing="6"
      styleClass="card"
      stylesheets="@style.css"
      style="-fx-padding: 10 14 10 14;">

    <!-- TOP ROW: File Name & Percentage -->
    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label fx:id="fileNameLabel" text="example.zip" HBox.hgrow="ALWAYS" styleClass="item-title" style="-fx-font-size: 14px;"/>
        <Pane HBox.hgrow="ALWAYS"/>
        <Label fx:id="percentageLabel" text="0%" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #3b82f6;"/>
    </HBox>

    <!-- MIDDLE ROW: Progress Bar -->
    <ProgressBar fx:id="progressBar" progress="0" maxWidth="Infinity" prefHeight="6" styleClass="progress-bar"/>

    <!-- BOTTOM ROW: Speed, Time & Action Buttons All in One Compact Line -->
    <HBox spacing="12" alignment="CENTER_LEFT">
        <Label fx:id="speedLabel" text="Speed: 0 KB/s" styleClass="text-muted" style="-fx-font-size: 11px;"/>
        <Label fx:id="timeLabel" text="ETA: --" styleClass="text-muted" style="-fx-font-size: 11px;"/>

        <!-- Spacer to push buttons to the right -->
        <Pane HBox.hgrow="ALWAYS"/>

        <!-- Action Buttons (Compact) -->
        <Button fx:id="showFolderButton" text="📁" onAction="#showInFolder" disable="true" styleClass="btn-secondary, btn-icon"/>
        <Button fx:id="deleteButton" text="Delete" onAction="#handleDelete" disable="true" styleClass="btn-secondary"/>

        <Button fx:id="downloadAgainButton" text="Retry" onAction="#downloadAgain" disable="true" styleClass="btn-secondary" style="-fx-text-fill: #3b82f6;"/>
        <Button fx:id="pauseButton" text="Pause" onAction="#pauseDownload" styleClass="btn-secondary"/>
        <Button fx:id="cancelButton" text="Cancel" onAction="#cancelDownload" styleClass="btn-danger-outline"/>
    </HBox>
</VBox>