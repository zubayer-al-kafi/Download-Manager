<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml/1"
      xmlns="http://javafx.com/javafx/26"
      fx:controller="com.downloadmanager.controller.HistoryItemController"
      spacing="8"
      styleClass="card"
      stylesheets="@style.css">

    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label fx:id="fileNameLabel" text="example.zip" styleClass="item-title" HBox.hgrow="ALWAYS"/>
        <Label fx:id="statusLabel" text="Completed" style="-fx-font-weight: bold; -fx-text-fill: #3b82f6;"/>
    </HBox>

    <Label fx:id="urlLabel" text="https://example.com/file.zip" maxWidth="Infinity" styleClass="text-muted"/>
    <Label fx:id="pathLabel" text="E:\Downloads\file.zip" maxWidth="Infinity" styleClass="text-muted"/>

</VBox>