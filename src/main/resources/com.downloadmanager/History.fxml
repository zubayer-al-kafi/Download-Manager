<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1"
            xmlns="http://javafx.com/javafx/26"
            fx:controller="com.downloadmanager.controller.HistoryController"
            prefWidth="900"
            prefHeight="600"
            style="-fx-background-color: #f4f6f8;">

    <top>

        <VBox spacing="5"
              alignment="CENTER"
              style="-fx-background-color: #202938;
                     -fx-padding: 25 30 25 30;">

            <Label text="DOWNLOAD HISTORY"
                   style="-fx-font-size: 26px;
                          -fx-font-weight: bold;
                          -fx-text-fill: white;"/>

            <Label text="Your previous downloads"
                   style="-fx-font-size: 13px;
                          -fx-text-fill: #b9c2cf;"/>

        </VBox>

    </top>


    <center>

        <VBox spacing="15"
              style="-fx-padding: 25 35 20 35;">

            <HBox alignment="CENTER_LEFT"
                  spacing="10">

                <Label fx:id="totalLabel"
                       text="Total: 0"
                       style="-fx-font-size: 13px;
              -fx-text-fill: #555f6d;
              -fx-font-weight: bold;"/>

                <Label fx:id="completedLabel"
                       text="Completed: 0"
                       style="-fx-font-size: 13px;
              -fx-text-fill: #2878d0;
              -fx-font-weight: bold;"/>

                <Label fx:id="cancelledLabel"
                       text="Cancelled: 0"
                       style="-fx-font-size: 13px;
              -fx-text-fill: #d9534f;
              -fx-font-weight: bold;"/>
                <Label fx:id="failedLabel"
                       text="Failed: 0"
                       style="-fx-font-size: 13px;
              -fx-text-fill: #f0ad4e;
              -fx-font-weight: bold;"/>
                <Label text="Download History"
                       style="-fx-font-size: 18px;
                  -fx-font-weight: bold;
                  -fx-text-fill: #202938;"
                       HBox.hgrow="ALWAYS"/>

                <Button text="Clear History"
                        onAction="#clearHistory"
                        style="-fx-background-color: #d9534f;
                   -fx-text-fill: white;
                   -fx-font-weight: bold;
                   -fx-background-radius: 6;
                   -fx-padding: 8 15 8 15;
                   -fx-cursor: hand;"/>

            </HBox>


            <ListView fx:id="historyList"
                      VBox.vgrow="ALWAYS"
                      style="-fx-background-color: white;
                             -fx-border-color: #e0e4e8;
                             -fx-border-radius: 10;
                             -fx-background-radius: 10;
                             -fx-padding: 6;"/>

        </VBox>

    </center>


    <bottom>

        <HBox alignment="CENTER"
              style="-fx-background-color: white;
                     -fx-border-color: #e0e4e8;
                     -fx-border-width: 1 0 0 0;
                     -fx-padding: 12 20 12 20;">

            <Button text="Back to Downloads"
                    onAction="#backToDownloads"
                    style="-fx-background-color: #2878d0;
                           -fx-text-fill: white;
                           -fx-font-weight: bold;
                           -fx-background-radius: 6;
                           -fx-padding: 9 22 9 22;
                           -fx-cursor: hand;"/>

        </HBox>

    </bottom>

</BorderPane>